# Copy to .env and replace every placeholder before starting the application.
WCDMS_ENVIRONMENT=development
WCDMS_DATABASE_URL=postgresql+asyncpg://wcdms:change_me@localhost:5432/wcdms
WCDMS_JWT_SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_characters_long
WCDMS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
WCDMS_DOCUMENT_STORAGE_ROOT=/absolute/private/path/to/wcdms-documents
WCDMS_LOA_UPLOAD_MAX_BYTES=26214400
